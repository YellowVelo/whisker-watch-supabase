# Copy this file to .env for local development. .env is gitignored —
# never commit real values.
#
# Get these from your Supabase project: Settings -> API.
#
# Which project to point at:
#   Local dev            -> wysker-watch-dev
#   staging branch/deploy -> wysker-watch-staging (set in the Cloudflare
#                            Pages dashboard, not in a committed file)
#   main / production     -> wysker-watch (prod) (set wherever prod's
#                            build environment is configured)
#
# Never point your local .env at the production project — a local dev
# server writes real data through it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sentry error/crash monitoring (spec 0052). Optional — if VITE_SENTRY_DSN
# is unset, monitoring is a silent no-op and the app behaves normally.
# One Sentry project/DSN is shared across all environments; only the
# environment tag differs (development locally, staging/production set in
# the Cloudflare Pages build environment for those builds).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Cloudflare Turnstile site key for the public /beta signup form (spec
# 0053). Safe to be public — this is the client-side widget key, not the
# secret used to verify tokens server-side (that's the TURNSTILE_SECRET_KEY
# Edge Function secret, set per Supabase project, never in this file).
# For local dev, Cloudflare's documented "always passes" TEST site key
# below is fine — it renders a visible widget that always succeeds, no
# real Cloudflare Turnstile site needed for local development.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
