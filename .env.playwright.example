# Copy this file to .env.playwright for running the Playwright E2E suite
# (npm run test:e2e). .env.playwright is gitignored — never commit real
# values.
#
# This MUST point at the wysker-watch-dev Supabase project — same
# project the Deno Edge Function integration tests already run against
# (.github/workflows/ci.yml's edge-functions job). Never wysker-watch-staging
# or Whisker-Watch (prod) — these tests sign in as a real account and
# create/delete real rows.
#
# Get VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY from wysker-watch-dev's
# dashboard: Settings -> API -> Publishable key (same values as your
# local .env, if that's already pointed at wysker-watch-dev).

PLAYWRIGHT_BASE_URL=http://localhost:5173

VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-publishable-or-anon-key

# Cloudflare's publicly documented "always passes" TEST site key (same
# value as .env.example) — auto-completes the widget with no visible
# challenge, which is what beta-signup.spec.js expects. Not a secret.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The wysker-watch-dev fixture account reserved for this suite. test2@
# stays reserved for the existing Deno CI tests so the two suites never
# collide on the same account.
PLAYWRIGHT_TEST1_EMAIL=test1@wyskerwatch.com
PLAYWRIGHT_TEST1_PASSWORD=test1s-actual-password

# test3@ — a dedicated profiles.role='admin' fixture account (spec 0053),
# used only by the admin-gated /admin/beta-signups tests. Not reused as
# the suite's default logged-in session (that's still test1@) so making
# this account admin never changes what "logged in" means for every other
# test. See migration 0049_test3_admin_fixture_account.sql.
PLAYWRIGHT_TEST3_ADMIN_EMAIL=test3@wyskerwatch.com
PLAYWRIGHT_TEST3_ADMIN_PASSWORD=test3s-actual-password

# test4@ — a dedicated fixture account (spec 0057) used only by
# e2e/pet-sitter.spec.js to play "a sitter looking at someone else's pet".
# Signed into locally within that spec file, not global-setup.js/fixtures.js,
# so no other test in the suite is affected by this account existing. See
# migration 0051_test4_sitter_fixture_account.sql.
PLAYWRIGHT_TEST4_SITTER_EMAIL=test4@wyskerwatch.com
PLAYWRIGHT_TEST4_SITTER_PASSWORD=test4s-actual-password
